<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<DefaultItemExcludes>$(DefaultItemExcludes);Shelter_Hervas.Domain\**;Shelter_Hervas.Infrastructure\**;Shelter_Hervas.Application\**</DefaultItemExcludes>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="Shelter_Hervas.Application\Shelter_Hervas.Application.csproj" />
		<ProjectReference Include="Shelter_Hervas.Domain\Shelter_Hervas.Domain.csproj" />
		<ProjectReference Include="Shelter_Hervas.Infrastructure\Shelter_Hervas.Infrastructure.csproj" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	<ItemGroup>
		<AdditionalFiles Include="Areas\Manager\Views\_ViewImports.cshtml" />
		<AdditionalFiles Include="Areas\Manager\Views\_ViewStart.cshtml" />
	</ItemGroup>
</Project>