<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] | HERVAS</title>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="page">
        <header class="header">
            <a asp-controller="Home" asp-action="Index" class="brand">
                <div class="brand-mark">HERVAS</div>
                <div><div class="brand-sub">ADOPCE A VIRTUÁLNÍ PÉČE O ZVÍŘATA</div></div>
            </a>
            <div class="top-links" id="topAuthLinks"></div>
            <nav class="nav">
                <a asp-controller="Home" asp-action="Index">ÚVOD</a>
                <a asp-controller="Animal" asp-action="Index">KATALOG ZVÍŘAT</a>
                <a asp-controller="Home" asp-action="Adopce">JAK ADOPTOVAT</a>
                <a asp-controller="Home" asp-action="Pomoc">CHCI POMOCI</a>
                <a asp-controller="Profile" asp-action="Index" id="navProfilLink" class="hidden">MŮJ PROFIL</a>
                <a asp-controller="Account" asp-action="Login" id="navAuthLink">PŘIHLÁŠENÍ / REGISTRACE</a>
            </nav>
        </header>

        <main class="page-section">
            @RenderBody()
        </main>

        <footer class="footer">
            <div class="footer-content">
                <div class="footer-left">
                    <strong>HERVAS ADOPČNÍ SYSTÉM</strong>
                    <p>Pomoc zvířatům v nouzi – reálné i virtuální adopce.</p>
                </div>
                <div class="footer-right">
                    <strong>© 2026 HERVAS · Všechna práva vyhrazena</strong>
                    <div class="footer-sub">U Zvířat 15, Praha 10 | +420 777 123 456</div>
                </div>
            </div>
        </footer>
    </div>

    <script src="~/js/script.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>