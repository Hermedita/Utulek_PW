@{
    ViewData["Title"] = "Úvod";
}

<div class="hero" id="heroSlideshow">
    <div class="hero-slide slide-in" id="heroSlide1"></div>
    <div class="hero-slide slide-out" id="heroSlide2"></div>
    <div class="hero-overlay">
        <span class="eyebrow">HERVAS · ZÁCHRANNÉ CENTRUM A ADOPCE</span>
        <h1>Pomozte zvířeti,<br>které potřebuje lásku a péči.</h1>
        <p>Každé zvíře má svůj jedinečný příběh. Nabízíme možnost klasické reálné adopce do nového domova, stejně jako možnost virtuální adopce.</p>
        <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 15px;">
            <a asp-controller="Animal" asp-action="Index" class="btn" style="background:#2a7b4c; color:white; padding:10px 18px; text-decoration:none; font-weight:bold;">PROHLÉDNOUT KATALOG ZVÍŘAT</a>
            <button onclick="generalAdoption(200)" style="background: #444; border:0; color:white; padding:10px 18px; cursor:pointer; font-weight:bold;">PŘISPĚT 200 KČ</button>
        </div>
    </div>
</div>

<section class="intro-box" style="margin-top: 16px;">
    <h2>DVĚ MOŽNOSTI ADOPCE V HERVAS</h2>
    <div class="adoption-types-grid">
        <div class="type-card">
            <h3>REÁLNÁ ADOPCE</h3>
            <p>Hledáte nového čtyřnohého člena rodiny? Vyberte si zvíře určené k adopci, podávejte žádost s motivačním dopisem a poskytněte mu domov.</p>
        </div>
        <div class="type-card">
            <h3>VIRTUÁLNÍ ADOPCE</h3>
            <p>Nemůžete si vzít zvíře domů, ale chcete pomáhat? Virtuální adopcí přispíváte na krmivo, léky a péči vybranému zvířeti v azylu.</p>
        </div>
    </div>
</section>

<section id="kontakt" class="contact-section" style="margin-top: 16px;">
    <span class="eyebrow">JSME TU PRO VÁS</span>
    <h1>KONTAKT A DOTAZY</h1>
    <p>Máte dotaz k reálné adopci, návštěvě azylu nebo možnosti virtuální podpory? Napište nám nebo vyplňte formulář níže.</p>
    <div class="contact-grid">
        <div class="contact-card"><strong>ZÁCHRANNÝ AZYL HERVAS</strong><p>U Zvířat 15<br>100 00 Praha 10</p></div>
        <div class="contact-card"><strong>TELEFONNÍ SPOJENÍ</strong><p>+420 777 123 456<br>(Po–Pá: 9:00–16:00)</p></div>
        <div class="contact-card"><strong>E-MAIL</strong><p>info@hervas.cz<br>adopce@hervas.cz</p></div>
        <div class="contact-card"><strong>NÁVŠTĚVNÍ HODINY</strong><p>So–Ne: 10:00–15:00<br>(po předchozí domluvě)</p></div>
    </div>

    <div class="contact-form-box" style="margin-top: 26px;">
        <h2>NAPIŠTE NÁM ZPRÁVU</h2>
        <form onsubmit="handleContactMessageSubmit(event)">
            <div class="form-row">
                <input type="text" id="contactName" placeholder="Vaše jméno a příjmení" required>
                <input type="email" id="contactEmail" placeholder="Váš e-mail" required>
            </div>
            <textarea id="contactText" placeholder="Napište nám váš dotaz nebo vzkaz..." required style="height: 100px;"></textarea>
            <button type="submit">ODESLAT ZPRÁVU</button>
        </form>
    </div>
</section>