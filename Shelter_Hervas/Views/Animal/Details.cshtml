@{
    ViewData["Title"] = "Detail zvířete";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
    <a asp-controller="Animal" asp-action="Index" class="back-button" style="margin: 0;">← Zpět na katalog</a>
    <div id="detailStaffActions" class="hidden" style="display: flex; gap: 8px; flex-wrap: wrap;"></div>
</div>

<div class="animal-detail">
    <div class="detail-photo" id="detailPhoto"></div>
    <div class="detail-content">
        <div style="display: flex; align-items: center; gap: 12px;">
            <h1 id="detailName" style="margin: 0;">Jméno</h1>
            <span id="detailStatusBadge" class="badge">Aktivní</span>
        </div>
        <p class="eyebrow" id="detailTypeGender" style="margin: 6px 0 14px;"></p>
        <p id="detailIntro" style="font-weight: 500; font-size: 17px;"></p>
        <h2>O zvířeti a jeho příběh</h2>
        <p id="detailText"></p>
        <h2>Péče a potřeby</h2>
        <p id="detailCare"></p>
        <h2>Umístění</h2>
        <p id="detailLocation"></p>

        <div id="adoptionButtonsContainer" class="hidden" style="display: flex; gap: 12px; margin-top: 25px;">
            <button id="btnRealAdoption" onclick="openRealAdoptionModal()" style="border: 0; background: #555; color: white; padding: 12px 20px; cursor: pointer; font: 700 15px Oswald, sans-serif;">ŽÁDOST O REÁLNOU ADOPCI</button>
            <button id="btnVirtualAdoption" onclick="openVirtualAdoptionModal()" style="border: 0; background: #2a7b4c; color: white; padding: 12px 20px; cursor: pointer; font: 700 15px Oswald, sans-serif;">VIRTUÁLNÍ ADOPCE</button>
        </div>
        <p id="adoptionUnavailableNotice" class="hidden" style="color: #b83232; font-weight: bold; margin-top: 15px;">Zvíře není aktuálně aktivní pro adopci.</p>
    </div>
</div>

<div class="modal" id="adoptionModal">
    <div class="modal-box">
        <button class="close" onclick="closeAdoptionModal()">×</button>
        <h2>Virtuální adopce</h2>
        <p id="adoptText">Zvolte částku příspěvku:</p>
        <div class="amounts">
            <button onclick="chooseAmount(100)">100 Kč</button>
            <button onclick="chooseAmount(300)">300 Kč</button>
            <button onclick="chooseAmount(1000)">1000 Kč</button>
        </div>
    </div>
</div>

<div class="modal" id="realAdoptionModal">
    <div class="modal-box" style="text-align: left; width: min(500px, 100%);">
        <button class="close" onclick="closeRealAdoptionModal()">×</button>
        <h2>Žádost o reálnou adopci</h2>
        <p id="realAdoptText" style="font-size: 14px; color: #555; margin-bottom: 12px;"></p>
        <form onsubmit="submitRealAdoption(event)">
            <textarea id="realAdoptMotivation" placeholder="Proč chcete zvíře adoptovat? Uveďte své zkušenosti a podmínky..." required style="width: 100%; height: 100px; padding: 10px; border: 1px solid #ccc; font-family: Roboto;"></textarea>
            <button type="submit" style="margin-top: 12px; width: 100%; padding: 12px; background: #2a7b4c; color: white; border: 0; font-weight: bold; cursor: pointer;">Odeslat žádost</button>
        </form>
    </div>
</div>